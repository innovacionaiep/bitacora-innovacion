// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
// Reference: https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password          String?   // Hashed password for credentials auth
  passwordEncrypted String?   @db.Text // Encrypted for admin display (reversible)
  image             String?
  activeRole    String?   @map("active_role") // Current active role
  lastActiveAt  DateTime? @map("last_active_at") // Última vez que inició sesión (JWT no escribe en Session)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  roles     UserRole[]
  proyectos ProyectoParticipante[]
  comentariosIndicador ComentarioIndicador[]
  comentariosItemPresupuesto ComentarioItemPresupuesto[]
  comentariosActividad ComentarioActividad[]
  historialProyecto HistorialProyecto[]
  
  // Relaciones del Feed de Novedades
  posts         Post[]
  postLikes     PostLike[]      @relation("PostLikes")
  postComments  PostComment[]   @relation("PostComments")
  commentLikes  CommentLike[]   @relation("CommentLikes")
  eventoAsistencias EventoAsistente[] @relation("EventoAsistencias")

  // Reuniones de seguimiento como coordinador
  reunionesCoordinadas ReunionSeguimiento[]

  // Oportunidades/amenazas donde dio OK coordinador
  oportunidadesAmenazasOkPor OportunidadAmenaza[] @relation("OportunidadAmenazaOkPor")

  // Actividades validadas por este coordinador
  actividadesValidadasPor Activity[] @relation("ActivityValidadoPor")

  // Indicadores validados por este coordinador
  indicadoresValidadosPor Indicador[] @relation("IndicadorValidadoPor")

  // Borradores de proyectos (formulario crear proyecto)
  proyectoBorradores ProyectoBorrador[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Application Models

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String // 'Admin' | 'Coordinador' | 'Colaborador' | 'Encargado' | 'Docente' | 'Estudiante' | 'Beneficiario' - Ver docs/SISTEMA-ROLES.md
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model ProyectoBorrador {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  nombre    String   // Nombre del proyecto para mostrar en la lista (ej. "Sin nombre" si está vacío)
  payload   Json     // Estado completo del formulario
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("proyecto_borradores")
}

model Proyecto {
  id               String   @id @default(cuid())
  proyecto         String
  fondo            String
  sede             String
  youtubeUrl       String?  @map("youtube_url") @db.Text
  focalizacion     String? // Social|Productiva|Ambiental|null
  avanceGantt      Int      @default(0) @map("avance_gantt")
  objetivos        Int      @default(0)
  presupuestoUsado Int      @default(0) @map("presupuesto_usado")
  presupuestoTotal Int      @default(0) @map("presupuesto_total")
  reunionesHechas  Int      @default(0) @map("reuniones_hechas")
  reunionesTotales Int      @default(0) @map("reuniones_totales")
  participantes    Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relaciones
  activities         Activity[]
  participantes_rel  ProyectoParticipante[]
  escuelas           ProyectoEscuela[]
  carreras           ProyectoCarrera[]
  comunas            ProyectoComuna[]
  gruposInteres      ProyectoGrupoInteres[]
  sociosComunitarios ProyectoSocioComunitario[]
  objetivos_rel      ObjetivoProyecto[]
  desarrolloTecnico  DesarrolloTecnico?
  desarrolloTecnicoValores DesarrolloTecnicoValor[]
  indicadores        Indicador[]
  historial          HistorialProyecto[]
  snapshotsMensuales SnapshotMensualProyecto[]
  
  // Relación con el Feed de Novedades
  posts              PostProyecto[]

  // Módulo de Seguimiento
  reunionesSeguimiento   ReunionSeguimiento[]
  compromisos            CompromisoProyecto[]
  oportunidadesAmenazas  OportunidadAmenaza[]
  itemsPresupuesto       ItemPresupuesto[]

  @@map("proyectos")
}

enum CuentaPresupuesto {
  RRHH
  OPERACION
  INVERSION
}

enum EstadoGastoPresupuesto {
  PENDIENTE
  SOLICITADO
  EN_PEDIDO
  EJECUTADO_OK
}

model ItemPresupuesto {
  id           String                 @id @default(cuid())
  proyectoId   String                 @map("proyecto_id")
  cuenta       CuentaPresupuesto
  item         String
  detalle      String?
  monto        Int
  estado       EstadoGastoPresupuesto @default(PENDIENTE)
  idSolicitud  String?                @map("id_solicitud")
  idPedido     String?                @map("id_pedido")
  idRecepcion  String?                @map("id_recepcion")
  orden        Int                    @default(0)
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  proyecto     Proyecto               @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyecciones ProyeccionPresupuesto[]
  comentarios  ComentarioItemPresupuesto[]

  @@map("items_presupuesto")
}

model ProyeccionPresupuesto {
  id                 String          @id @default(cuid())
  itemPresupuestoId  String          @map("item_presupuesto_id")
  mes                Int // 1-12
  anio               Int
  monto              Int             @default(0)
  createdAt          DateTime        @default(now()) @map("created_at")

  itemPresupuesto ItemPresupuesto @relation(fields: [itemPresupuestoId], references: [id], onDelete: Cascade)

  @@unique([itemPresupuestoId, mes, anio])
  @@map("proyecciones_presupuesto")
}

// Participación en Proyectos (many-to-many con roles)
model ProyectoParticipante {
  id                 String   @id @default(cuid())
  proyectoId         String   @map("proyecto_id")
  userId             String?  @map("user_id") // Opcional: para participantes sin cuenta activa
  rol                String // Encargado|Coordinador|Colaborador|Docente|Estudiante|Beneficiario
  nombre             String? // Nombre del participante (cuando no tiene cuenta)
  email              String? // Email del participante (cuando no tiene cuenta)
  cargo              String? // Cargo del participante en el proyecto
  socioComunitarioId String?  @map("socio_comunitario_id") // Socio comunitario (obligatorio para Beneficiarios)
  sedeId             String?  @map("sede_id") // Sede (catálogo configuración - validación de datos)
  escuelaId          String?  @map("escuela_id") // Escuela (catálogo configuración - validación de datos)
  createdAt          DateTime @default(now()) @map("created_at")

  proyecto         Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  socioComunitario SocioComunitario? @relation(fields: [socioComunitarioId], references: [id], onDelete: SetNull)
  sede             Sede?            @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  escuela          Escuela?         @relation(fields: [escuelaId], references: [id], onDelete: SetNull)

  @@unique([proyectoId, userId, rol])
  @@map("proyecto_participantes")
}

// Sedes (catálogo para listas desplegables; Proyecto.sede sigue siendo String)
model Sede {
  id                    String                 @id @default(cuid())
  nombre                String
  orden                 Int                    @default(0)
  proyectoParticipantes ProyectoParticipante[]

  @@map("sedes")
}

// Escuelas del Proyecto (many-to-many)
model Escuela {
  id                    String                 @id @default(cuid())
  nombre                String
  codigo                String                 @unique
  proyectos             ProyectoEscuela[]
  carreras              Carrera[]
  proyectoParticipantes ProyectoParticipante[]

  @@map("escuelas")
}

model ProyectoEscuela {
  proyectoId String @map("proyecto_id")
  escuelaId  String @map("escuela_id")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  escuela  Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)

  @@id([proyectoId, escuelaId])
  @@map("proyecto_escuelas")
}

// Carreras del Proyecto (many-to-many)
model Carrera {
  id        String  @id @default(cuid())
  nombre    String
  escuelaId String? @map("escuela_id")

  escuela   Escuela?          @relation(fields: [escuelaId], references: [id])
  proyectos ProyectoCarrera[]

  @@map("carreras")
}

model ProyectoCarrera {
  proyectoId String @map("proyecto_id")
  carreraId  String @map("carrera_id")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  carrera  Carrera  @relation(fields: [carreraId], references: [id], onDelete: Cascade)

  @@id([proyectoId, carreraId])
  @@map("proyecto_carreras")
}

// Comunas del Proyecto (many-to-many)
model Comuna {
  id     String @id @default(cuid())
  nombre String
  region String

  proyectos ProyectoComuna[]

  @@map("comunas")
}

model ProyectoComuna {
  proyectoId String @map("proyecto_id")
  comunaId   String @map("comuna_id")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  comuna   Comuna   @relation(fields: [comunaId], references: [id], onDelete: Cascade)

  @@id([proyectoId, comunaId])
  @@map("proyecto_comunas")
}

// Grupos de Interés (many-to-many)
model GrupoInteres {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?

  proyectos ProyectoGrupoInteres[]

  @@map("grupos_interes")
}

model ProyectoGrupoInteres {
  proyectoId     String @map("proyecto_id")
  grupoInteresId String @map("grupo_interes_id")

  proyecto     Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  grupoInteres GrupoInteres @relation(fields: [grupoInteresId], references: [id], onDelete: Cascade)

  @@id([proyectoId, grupoInteresId])
  @@map("proyecto_grupos_interes")
}

// Socios Comunitarios (many-to-many, texto libre)
model SocioComunitario {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?

  proyectos           ProyectoSocioComunitario[]
  participantes      ProyectoParticipante[]

  @@map("socios_comunitarios")
}

model ProyectoSocioComunitario {
  proyectoId         String @map("proyecto_id")
  socioComunitarioId String @map("socio_comunitario_id")

  proyecto         Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  socioComunitario SocioComunitario @relation(fields: [socioComunitarioId], references: [id], onDelete: Cascade)

  @@id([proyectoId, socioComunitarioId])
  @@map("proyecto_socios_comunitarios")
}

// Objetivos del Proyecto
model ObjetivoProyecto {
  id          String   @id @default(cuid())
  proyectoId  String   @map("proyecto_id")
  tipo        String // General|Especifico
  descripcion String
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  proyecto    Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  indicadores Indicador[]

  @@map("objetivos_proyecto")
}

enum ActivityStatus {
  TODO
  WAITING
  IN_PROGRESS
  DONE
}

model Activity {
  id                     String         @id @default(cuid())
  name                   String
  description            String         @default("")
  progress               Int            @default(0)
  projectId              String         @map("project_id")
  color                  String         @default("bg-gray-700")
  orderIndex             Int            @default(0) @map("order_index")
  kanbanOrderIndex       Int            @default(0) @map("kanban_order_index")
  status                 ActivityStatus @default(TODO)
  validadoPorCoordinador Boolean        @default(false) @map("validado_por_coordinador")
  validadoPorCoordinadorId String?       @map("validado_por_coordinador_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  project                Proyecto       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  comentarios            ComentarioActividad[]
  evidencias             EvidenciaActividad[]
  validadoPorCoordinadorPor User?       @relation("ActivityValidadoPor", fields: [validadoPorCoordinadorId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model Task {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  completed   Boolean  @default(false)
  startDate   String   @map("start_date") // Stored as string for consistency with existing app
  endDate     String   @map("end_date")
  progress    Int      @default(0)
  activityId  String   @map("activity_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tareasMarcadasEnReunion TareaMarcadaEnReunion[]

  @@map("tasks")
}

model DesarrolloTecnico {
  id                         String   @id @default(cuid())
  proyectoId                 String   @unique @map("proyecto_id")
  continuidadFasesAnteriores String?  @map("continuidad_fases_anteriores") @db.Text
  pertinenciaLocal           String?  @map("pertinencia_local") @db.Text
  pertinenciaDisciplinar     String?  @map("pertinencia_disciplinar") @db.Text
  necesidadProblema          String?  @map("necesidad_problema") @db.Text
  publicoObjetivo            String?  @map("publico_objetivo") @db.Text
  solucionAvance             String?  @map("solucion_avance") @db.Text
  perspectiveGenero          String?  @map("perspective_genero") @db.Text
  resultadosContribucion     String?  @map("resultados_contribucion") @db.Text
  metodologiaMedicion        String?  @map("metodologia_medicion") @db.Text
  ejesImpacto                String?  @map("ejes_impacto") @db.Text
  factorInnovador            String?  @map("factor_innovador") @db.Text
  escalabilidad              String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("desarrollo_tecnico")
}

// Configuración de categorías y subcategorías del desarrollo técnico (editable en Configuración)
model DesarrolloTecnicoCategoria {
  id            String   @id @default(cuid())
  nombre        String
  orden         Int      @default(0)
  subcategorias DesarrolloTecnicoSubcategoria[]

  @@map("desarrollo_tecnico_categorias")
}

model DesarrolloTecnicoSubcategoria {
  id          String   @id @default(cuid())
  categoriaId String   @map("categoria_id")
  nombre      String
  icono       String   @default("FileText") // nombre del icono Lucide
  orden       Int      @default(0)
  campoKey    String?  @map("campo_key") // mapeo a columna antigua para migración

  categoria DesarrolloTecnicoCategoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  valores   DesarrolloTecnicoValor[]

  @@map("desarrollo_tecnico_subcategorias")
}

// Valores por proyecto y subcategoría (modelo flexible)
model DesarrolloTecnicoValor {
  id             String   @id @default(cuid())
  proyectoId     String   @map("proyecto_id")
  subcategoriaId String   @map("subcategoria_id")
  valor          String   @db.Text

  proyecto     Proyecto                   @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  subcategoria DesarrolloTecnicoSubcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, subcategoriaId])
  @@map("desarrollo_tecnico_valores")
}

// Indicadores del Proyecto
model Indicador {
  id                     String   @id @default(cuid())
  proyectoId             String   @map("proyecto_id")
  objetivoEspecificoId   String   @map("objetivo_especifico_id")
  nombre                 String
  descripcion            String   @db.Text
  formaCalculo           String   @map("forma_calculo") @db.Text
  resultadoEsperado      String   @map("resultado_esperado")
  resultadoAlcanzado     String   @default("0") @map("resultado_alcanzado")
  formatoNumero          String?  @default("Porcentaje") @map("formato_numero")
  porcentajeCumplimiento Float    @default(0) @map("porcentaje_cumplimiento")
  porcentajeAvance       Float    @default(0) @map("porcentaje_avance")
  fechaInicio            String?  @map("fecha_inicio") // Formato: YYYY-MM-DD
  fechaFin               String?  @map("fecha_fin") // Formato: YYYY-MM-DD
  validadoPorCoordinador Boolean  @default(false) @map("validado_por_coordinador")
  validadoPorCoordinadorId String? @map("validado_por_coordinador_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  proyecto           Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  objetivoEspecifico ObjetivoProyecto @relation(fields: [objetivoEspecificoId], references: [id], onDelete: Cascade)
  comentarios       ComentarioIndicador[]
  actualizacionesEnReunion IndicadorActualizadoEnReunion[]
  evidencias        EvidenciaIndicador[]
  validadoPorCoordinadorPor User? @relation("IndicadorValidadoPor", fields: [validadoPorCoordinadorId], references: [id], onDelete: SetNull)

  @@map("indicadores")
}

// Comentarios de Actividades
model ComentarioActividad {
  id          String   @id @default(cuid())
  actividadId String   @map("actividad_id")
  userId      String   @map("user_id")
  contenido   String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actividad Activity @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actividadId])
  @@map("comentarios_actividad")
}

// Evidencias de Actividades (imágenes JPG y PDF en Cloudinary, carpeta evidencias_actividades)
model EvidenciaActividad {
  id            String   @id @default(cuid())
  actividadId   String   @map("actividad_id")
  url           String
  publicId      String   @map("public_id")
  tipo          String   // 'image' | 'pdf'
  nombreArchivo String?  @map("nombre_archivo")
  createdAt     DateTime @default(now()) @map("created_at")

  actividad Activity @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@index([actividadId])
  @@map("evidencias_actividad")
}

// Evidencias de Indicadores (imágenes JPG y PDF en Cloudinary, misma carpeta que actividades)
model EvidenciaIndicador {
  id            String   @id @default(cuid())
  indicadorId   String   @map("indicador_id")
  url           String
  publicId      String   @map("public_id")
  tipo          String   // 'image' | 'pdf'
  nombreArchivo String?  @map("nombre_archivo")
  createdAt     DateTime @default(now()) @map("created_at")

  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  @@index([indicadorId])
  @@map("evidencias_indicador")
}

// Comentarios de Indicadores
model ComentarioIndicador {
  id          String   @id @default(cuid())
  indicadorId String   @map("indicador_id")
  userId      String   @map("user_id")
  contenido   String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([indicadorId])
  @@map("comentarios_indicador")
}

// Comentarios de Ítems de Presupuesto
model ComentarioItemPresupuesto {
  id                String   @id @default(cuid())
  itemPresupuestoId String   @map("item_presupuesto_id")
  userId            String   @map("user_id")
  contenido         String   @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  itemPresupuesto ItemPresupuesto @relation(fields: [itemPresupuestoId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemPresupuestoId])
  @@map("comentarios_item_presupuesto")
}

// Historial de Proyectos
model HistorialProyecto {
  id                String   @id @default(cuid())
  proyectoId        String   @map("proyecto_id")
  userId            String   @map("user_id")
  accion            String   // Crear, Comentar, Actualizar, Marcar realizada, etc.
  tabProyecto       String   @map("tab_proyecto") // Actividades, Indicadores, Presupuesto, etc.
  elementoEspecifico String   @map("elemento_especifico") @db.Text // Nombre del elemento afectado
  cambioGenerado    String   @map("cambio_generado") @db.Text // Texto del cambio
  fecha             DateTime @default(now())
  createdAt         DateTime @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@index([userId])
  @@map("historial_proyecto")
}

// Snapshots Mensuales de Proyectos - Para calcular variación de avances
model SnapshotMensualProyecto {
  id          String   @id @default(cuid())
  proyectoId  String   @map("proyecto_id")
  mes         Int      // 1-12
  anio        Int      // 2025, 2026, etc.
  avanceGantt Int      @default(0) @map("avance_gantt")
  objetivos   Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, mes, anio])
  @@index([proyectoId])
  @@map("snapshots_mensuales_proyecto")
}

// ========================
// MÓDULO DE SEGUIMIENTO
// ========================

model ReunionSeguimiento {
  id               String    @id @default(cuid())
  proyectoId       String    @map("proyecto_id")
  coordinadorId    String    @map("coordinador_id")
  fecha            DateTime
  duracionMinutos  Int?      @map("duracion_minutos")
  resumen          String?   @db.Text
  notas            String?   @db.Text
  estado           String?   @default("programada") // programada | en_curso | finalizada
  inicioEnVivoAt   DateTime? @map("inicio_en_vivo_at")
  transcripcion    String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  proyecto    Proyecto   @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  coordinador User       @relation(fields: [coordinadorId], references: [id], onDelete: Cascade)

  puntosTratados           PuntoReunion[]
  tareasMarcadas           TareaMarcadaEnReunion[]
  indicadoresActualizados  IndicadorActualizadoEnReunion[]
  oportunidadesAmenazas    PuntoFODA[]
  temasPresupuesto         TemaPresupuestoReunion[]
  compromisos              CompromisoProyecto[]

  @@index([proyectoId])
  @@index([coordinadorId])
  @@index([fecha])
  @@map("reuniones_seguimiento")
}

model PuntoReunion {
  id          String   @id @default(cuid())
  reunionId   String   @map("reunion_id")
  titulo      String
  descripcion String?  @db.Text
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  reunion ReunionSeguimiento @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([reunionId])
  @@map("puntos_reunion")
}

model TareaMarcadaEnReunion {
  id        String   @id @default(cuid())
  reunionId String   @map("reunion_id")
  taskId    String   @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  reunion ReunionSeguimiento @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  task   Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([reunionId, taskId])
  @@index([reunionId])
  @@map("tareas_marcadas_en_reunion")
}

model IndicadorActualizadoEnReunion {
  id             String   @id @default(cuid())
  reunionId      String   @map("reunion_id")
  indicadorId    String   @map("indicador_id")
  valorAnterior  String   @map("valor_anterior")
  valorNuevo     String   @map("valor_nuevo")
  createdAt      DateTime @default(now()) @map("created_at")

  reunion   ReunionSeguimiento @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  indicador Indicador          @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  @@index([reunionId])
  @@map("indicadores_actualizados_en_reunion")
}

model PuntoFODA {
  id          String   @id @default(cuid())
  reunionId   String   @map("reunion_id")
  tipo        String   // 'Oportunidad' | 'Amenaza'
  descripcion String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  reunion ReunionSeguimiento @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([reunionId])
  @@map("puntos_foda")
}

model TemaPresupuestoReunion {
  id              String   @id @default(cuid())
  reunionId       String   @map("reunion_id")
  tema            String
  descripcion     String?  @db.Text
  cambioPropuesto String?  @map("cambio_propuesto") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  reunion ReunionSeguimiento @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([reunionId])
  @@map("temas_presupuesto_reunion")
}

model OportunidadAmenaza {
  id                      String   @id @default(cuid())
  proyectoId              String   @map("proyecto_id")
  tipo                    String   // 'Oportunidad' | 'Amenaza'
  nombre                  String   @default("") // Nombre/título de la oportunidad o amenaza
  descripcion             String   @db.Text
  planDeAccion            String?  @db.Text @map("plan_de_accion")
  okCoordinador           Boolean  @default(false) @map("ok_coordinador")
  okCoordinadorPorId      String?  @map("ok_coordinador_por_id")
  okCoordinadorPorRolActivo String? @map("ok_coordinador_por_rol_activo")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  proyecto         Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  okCoordinadorPor User?    @relation("OportunidadAmenazaOkPor", fields: [okCoordinadorPorId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([okCoordinadorPorId])
  @@map("oportunidades_amenazas")
}

model CompromisoProyecto {
  id                     String    @id @default(cuid())
  reunionId              String?   @map("reunion_id")
  proyectoId             String    @map("proyecto_id")
  titulo                 String?   // Título breve para la tarjeta (opcional; si no hay, se usa la primera línea de descripcion)
  descripcion            String    @db.Text
  fechaLimite            DateTime? @map("fecha_limite")
  completado             Boolean   @default(false)
  validadoPorCoordinador Boolean   @default(false) @map("validado_por_coordinador")
  asignadoA              String?   @map("asignado_a")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  reunion  ReunionSeguimiento? @relation(fields: [reunionId], references: [id], onDelete: SetNull)
  proyecto Proyecto           @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([reunionId])
  @@index([proyectoId])
  @@map("compromisos_proyecto")
}

// ========================
// FEED DE NOVEDADES
// ========================

// Publicaciones del Feed
model Post {
  id                 String   @id @default(cuid())
  contenido          String   @db.Text
  authorId           String   @map("author_id")
  authorRoleAtPost   String?  @map("author_role_at_post") // Rol activo del autor al momento de publicar
  eventoFecha        DateTime? @map("evento_fecha") // Fecha del evento (opcional, solo para posts tipo evento)
  eventoNombre       String?  @map("evento_nombre") // Nombre del evento (opcional, solo para posts tipo evento)
  eventoDescripcion  String?  @db.Text @map("evento_descripcion") // Descripción breve del evento (opcional)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  imagenes    PostImage[]
  videos      PostVideo[]
  proyectos   PostProyecto[]
  likes       PostLike[]
  comentarios PostComment[]
  asistentes  EventoAsistente[] @relation("EventoAsistentes")

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

// Imágenes de las publicaciones (almacenadas en Cloudinary)
model PostImage {
  id        String @id @default(cuid())
  postId    String @map("post_id")
  url       String
  publicId  String @map("public_id") // ID de Cloudinary para eliminación
  orden     Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

// Videos de YouTube embebidos en publicaciones
model PostVideo {
  id             String @id @default(cuid())
  postId         String @map("post_id")
  youtubeUrl     String @map("youtube_url")
  youtubeVideoId String @map("youtube_video_id")
  orden          Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_videos")
}

// Relación many-to-many entre Posts y Proyectos
model PostProyecto {
  postId     String @map("post_id")
  proyectoId String @map("proyecto_id")

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([postId, proyectoId])
  @@map("post_proyectos")
}

// Asistentes confirmados a eventos (solo aplica a posts tipo evento)
model EventoAsistente {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation("EventoAsistentes", fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("EventoAsistencias", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("evento_asistentes")
}

// Tipos de reacción en posts (estilo LinkedIn)
// Recomendar, Celebrar, Encantar

// Likes/reacciones en publicaciones
model PostLike {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  userId       String   @map("user_id")
  reactionType String   @default("Recomendar") @map("reaction_type") // Recomendar | Celebrar | Encantar
  createdAt    DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("post_likes")
}

// Comentarios en publicaciones (con soporte para respuestas anidadas)
model PostComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id") // Para respuestas anidadas
  contenido String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation("PostComments", fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId])
  @@index([parentId])
  @@map("post_comments")
}

// Likes en comentarios
model CommentLike {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("CommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_likes")
}
