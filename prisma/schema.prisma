// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
// Reference: https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // Hashed password for credentials auth
  image         String?
  activeRole    String?   @map("active_role") // Current active role
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  roles    UserRole[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Application Models

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   // 'Admin' | 'Evaluador' | 'Coordinador' | 'Encargado' | 'Participante'
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model Proyecto {
  id                 String     @id @default(cuid())
  proyecto           String
  fondo              String
  sede               String
  escuela            String
  avanceGantt        Int        @default(0) @map("avance_gantt")
  objetivos          Int        @default(0)
  presupuestoUsado   Int        @default(0) @map("presupuesto_usado")
  presupuestoTotal   Int        @default(0) @map("presupuesto_total")
  reunionesHechas    Int        @default(0) @map("reuniones_hechas")
  reunionesTotales   Int        @default(0) @map("reuniones_totales")
  participantes      Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  activities Activity[]

  @@map("proyectos")
}

model Activity {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  progress    Int      @default(0)
  projectId   String   @map("project_id")
  color       String   @default("bg-gray-700")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Proyecto @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("activities")
}

model Task {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  completed   Boolean  @default(false)
  startDate   String   @map("start_date") // Stored as string for consistency with existing app
  endDate     String   @map("end_date")
  progress    Int      @default(0)
  activityId  String   @map("activity_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("tasks")
}
